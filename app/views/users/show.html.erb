<div class="container px-5 px-sm-0">
  <div class="row">
     <div class="col-md-3">
      <%= render 'users/info', users: @users %>
      <%= render 'books/new', books: @books %>
      </div>
      <div class="col-md-8 offset-md-1">
      <%= render 'booksｖ/books', books: @books %>
       <% if current_user != @user %>
        <% if current_user.following?(@user) %>
          <%= link_to "フォロー外す", user_relationships_path(@user.id), method: :delete,class: "btn btn-secondary" %>
        <% else %>
          <%= link_to "フォローする", 
          user_relationships_path(@user.id), method: :post,class: "btn btn-success" %>
        <% end %>
      <% end>
      
      
     </div>
  </div>
</div>






